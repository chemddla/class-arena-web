    },
    "studentClaims": {
      ".read": "auth != null && auth.token.superAdmin === true",
      ".write": "auth != null && auth.token.superAdmin === true",
      "$classCode": {
        "$studentId": {
          ".write": "auth != null && !newData.exists() && (newData.parent().parent().parent().child('classes').child($classCode).child('meta').exists() && (!root.child('classes').child($classCode).child('meta/ownerUid').exists() || root.child('classes').child($classCode).child('meta/ownerUid').val() === auth.uid))",
          "$uid": {
