    "presence": {
      ".write": "auth != null && auth.token.superAdmin === true",
      "$classCode": {
        ".read": "$classCode.matches(/^[A-Z0-9_-]+$/) && $classCode.length >= 3 && $classCode.length <= 16",
        "$studentId": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('classMembers').child($classCode).child($uid).val() === $studentId && root.child('studentClaims').child($classCode).child($studentId).child($uid).exists()))",
            ".validate": "newData.isNumber() && newData.val() <= now"
          }
        }
      }
