          ".write": "auth != null && ((newData.parent().parent().parent().child('classes').child($classCode).child('meta').exists() && (!root.child('classes').child($classCode).child('meta/ownerUid').exists() || root.child('classes').child($classCode).child('meta/ownerUid').val() === auth.uid)) || (!data.exists() && newData.exists()) || root.child('studentClaims').child($classCode).child($studentId).child(auth.uid).exists())",
          ".validate": "newData.parent().parent().parent().child('classes').child($classCode).child('students').child($studentId).exists()",
