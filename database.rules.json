              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "room_chats": {
          "$kind": {
            "$roomId": {
              ".write": "!newData.exists() && root.child('classes').child($classCode).child('meta').exists() && (!root.child('classes').child($classCode).child('meta').child('ownerUid').exists() || (auth != null && root.child('classes').child($classCode).child('meta').child('ownerUid').val() === auth.uid) || (auth != null && root.child('studentClaims').child($classCode).child(root.child('classMembers').child($classCode).child(auth.uid).val()).child(auth.uid).exists()))",
              ".validate": "$kind.matches(/^(pvp|raid|minigame|home)$/) && $roomId.length >= 1 && $roomId.length <= 80",
