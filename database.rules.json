            ".read": "$proof.matches(/^sh_[0-9a-f]{64}$/) && data.exists()",
            ".validate": "($proof.matches(/^sh_[0-9a-f]{64}$/) && newData.val() === true) || ($proof === 'prev' && newData.isString() && newData.val().matches(/^sh_[0-9a-f]{64}$/))"
          }
