                ".validate": "$msgId.matches(/^c_[A-Za-z0-9_]{6,40}$/) && newData.hasChildren(['from', 'text', 'at']) && root.child('classes').child($classCode).child('students').child(newData.child('from').val()).exists() && newData.child('at').val() <= now",
