{
  "rules": {
    ".read": false,
    ".write": false,
    "classes": {
      "$classCode": {
        ".read": "$classCode.matches(/^[A-Z0-9_-]+$/) && $classCode.length >= 3 && $classCode.length <= 16",
        ".write": "$classCode.matches(/^[A-Z0-9_-]+$/) && $classCode.length >= 3 && $classCode.length <= 16"
      }
    },
    "teacherKeys": {
      "$keyHash": {
        ".read": true,
        ".write": "$keyHash.matches(/^kh_[0-9a-f]+$/)"
      }
    }
  }
}
