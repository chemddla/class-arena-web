{
  "rules": {
    ".read": false,
    ".write": false,
    "classes": {
      ".read": "auth != null && auth.token.superAdmin === true",
      ".write": "auth != null && auth.token.superAdmin === true",
      "$classCode": {
        ".read": "$classCode.matches(/^[A-Z0-9_-]+$/) && $classCode.length >= 3 && $classCode.length <= 16",
        ".validate": "$classCode.matches(/^[A-Z0-9_-]+$/) && $classCode.length >= 3 && $classCode.length <= 16",
        "meta": {
          ".write": "$classCode.matches(/^[A-Z0-9_-]+$/) && $classCode.length >= 3 && $classCode.length <= 16 && newData.exists() && (!data.exists() ? (auth != null && newData.child('classCode').val() === $classCode && newData.child('ownerUid').val() === auth.uid && newData.child('ownerEmail').val() === auth.token.email) : (newData.child('teacherKeyHash').val() === data.child('teacherKeyHash').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('ownerUid').val() === data.child('ownerUid').val() && newData.child('ownerEmail').val() === data.child('ownerEmail').val() && (!data.child('ownerUid').exists() || (auth != null && data.child('ownerUid').val() === auth.uid))))",
          "classCode": {
            ".validate": "newData.val() === $classCode"
          },
          "className": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "guardianPts": {
            ".write": "data.parent().exists() && newData.isNumber()"
          },
          "updatedAt": {
            ".write": "data.parent().exists() && newData.isNumber()"
          }
        },
        "students": {
          "$studentId": {
            ".write": "newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').exists() && ((!newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('ownerUid').exists() || (auth != null && newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('ownerUid').val() === auth.uid)) || (data.exists() && newData.exists() && (auth != null && newData.parent().parent().parent().parent().child('classMembers').child($classCode).child(auth.uid).val() === $studentId && newData.parent().parent().parent().parent().child('studentClaims').child($classCode).child($studentId).child(auth.uid).exists())))",
            "password": {
              ".validate": "newData.val() === data.val()"
            }
          }
        },
        "profiles": {
          "$studentId": {
            ".write": "newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').exists() && ((!newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('ownerUid').exists() || (auth != null && newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('ownerUid').val() === auth.uid)) || (data.exists() && newData.exists() && (auth != null && newData.parent().parent().parent().parent().child('classMembers').child($classCode).child(auth.uid).val() === $studentId && newData.parent().parent().parent().parent().child('studentClaims').child($classCode).child($studentId).child(auth.uid).exists())))",
            "password": {
              ".validate": "newData.val() === data.val()"
            },
            "claimed": {
              ".validate": "newData.isBoolean() && newData.val() === newData.parent().parent().parent().parent().parent().child('studentSecrets').child($classCode).child($studentId).exists()"
            }
          }
        },
        "auctions": {
          ".write": "newData.parent().child('meta').exists()"
        },
        "tradeOffers": {
          ".write": "newData.parent().child('meta').exists()"
        },
        "pvp_squads": {
          "$studentId": {
            ".write": "newData.parent().parent().child('meta').exists()"
          }
        },
        "pvp_rooms": {
          "$roomId": {
            ".write": "newData.parent().parent().child('meta').exists()"
          }
        },
        "raid_rooms": {
          "$roomId": {
            ".write": "newData.parent().parent().child('meta').exists()"
          }
        },
        "minigame_rooms": {
          "$roomId": {
            ".write": "newData.parent().parent().child('meta').exists()"
          }
        },
        "minigames": {
          "$roomId": {
            ".write": "newData.parent().parent().child('meta').exists()"
          }
        },
        "live_battle_events": {
          "$eventId": {
            ".write": "newData.parent().parent().child('meta').exists()"
          }
        },
        "pvp_live": {
          "$roomId": {
            ".write": "newData.parent().parent().child('meta').exists()"
          }
        },
        "transfers": {
          "$toId": {
            ".write": "newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').exists() && ((!newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('ownerUid').exists() || (auth != null && newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('ownerUid').val() === auth.uid)))",
            "$transferId": {
              ".write": "newData.parent().parent().parent().parent().parent().child('classes').child($classCode).child('meta').exists() && ((!newData.parent().parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('ownerUid').exists() || (auth != null && newData.parent().parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('ownerUid').val() === auth.uid)) || (!data.exists() && newData.exists() && (auth != null && newData.parent().parent().parent().parent().parent().child('classMembers').child($classCode).child(auth.uid).val() === newData.child('from').val() && newData.parent().parent().parent().parent().parent().child('studentClaims').child($classCode).child(newData.child('from').val()).child(auth.uid).exists())) || (data.exists() && !newData.exists() && (auth != null && newData.parent().parent().parent().parent().parent().child('classMembers').child($classCode).child(auth.uid).val() === $toId && newData.parent().parent().parent().parent().parent().child('studentClaims').child($classCode).child($toId).child(auth.uid).exists())))",
              ".validate": "$transferId.matches(/^t_[A-Za-z0-9_]{6,40}$/) && newData.hasChildren(['from', 'mc', 'at']) && newData.child('from').val() !== $toId && newData.parent().parent().parent().child('students').child(newData.child('from').val()).exists() && newData.parent().parent().parent().child('students').child($toId).exists() && newData.child('at').val() <= now",
              "from": {
                ".validate": "newData.isString()"
              },
              "fromName": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "kind": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "note": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "mc": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "merc": {
                ".validate": "newData.hasChildren(['id', 'job'])"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "teacherKeys": {
      "$keyHash": {
        ".read": true,
        "classes": {
          "$classCode": {
            ".write": "(auth != null && auth.token.superAdmin === true && !newData.exists()) || $keyHash.matches(/^kh_[0-9a-f]+$/) && newData.exists() && newData.child('classCode').val() === $classCode && newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('teacherKeyHash').val() === $keyHash"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "teacherClasses": {
      ".read": "auth != null && auth.token.superAdmin === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$classCode": {
          ".write": "auth != null && (auth.token.superAdmin === true || (auth.uid === $uid && (!newData.exists() || newData.parent().parent().parent().child('classes').child($classCode).child('meta/ownerUid').val() === $uid)))"
        }
      }
    },
    "teacherProfiles": {
      ".read": "auth != null && auth.token.superAdmin === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.child('email').val() === auth.token.email"
      }
    },
    "studentSecrets": {
      ".write": "auth != null && auth.token.superAdmin === true",
      "$classCode": {
        "$studentId": {
          ".write": "auth != null && ((newData.parent().parent().parent().child('classes').child($classCode).child('meta').exists() && (!root.child('classes').child($classCode).child('meta/ownerUid').exists() || root.child('classes').child($classCode).child('meta/ownerUid').val() === auth.uid)) || (!data.exists() && newData.exists()) || root.child('studentClaims').child($classCode).child($studentId).child(auth.uid).exists())",
          ".validate": "newData.parent().parent().parent().child('classes').child($classCode).child('students').child($studentId).exists()",
          "$proof": {
            ".validate": "$proof.matches(/^p_[0-9a-f]{64}$/) && newData.val() === true"
          }
        }
      }
    },
    "studentClaims": {
      ".read": "auth != null && auth.token.superAdmin === true",
      ".write": "auth != null && auth.token.superAdmin === true",
      "$classCode": {
        "$studentId": {
          ".write": "auth != null && !newData.exists() && (newData.parent().parent().parent().child('classes').child($classCode).child('meta').exists() && (!root.child('classes').child($classCode).child('meta/ownerUid').exists() || root.child('classes').child($classCode).child('meta/ownerUid').val() === auth.uid))",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.parent().parent().parent().parent().child('studentSecrets').child($classCode).child($studentId).child(newData.child('proof').val()).val() === true)",
            ".validate": "newData.hasChildren(['proof', 'at']) && newData.child('proof').isString() && newData.child('proof').val().matches(/^p_[0-9a-f]{64}$/) && newData.child('at').isNumber() && newData.child('at').val() <= now",
            "$other": {
              ".validate": "$other === 'proof' || $other === 'at'"
            }
          }
        }
      }
    },
    "classMembers": {
      ".read": "auth != null && auth.token.superAdmin === true",
      ".write": "auth != null && auth.token.superAdmin === true",
      "$classCode": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.isString() && newData.parent().parent().parent().child('studentClaims').child($classCode).child(newData.val()).child($uid).exists()))"
        }
      }
    }
  }
}
