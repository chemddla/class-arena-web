              ".validate": "$inviteId.matches(/^i_[A-Za-z0-9_]{6,40}$/) && newData.hasChildren(['from', 'kind', 'roomId', 'at']) && newData.child('from').val() !== $toId && root.child('classes').child($classCode).child('students').child(newData.child('from').val()).exists() && root.child('classes').child($classCode).child('students').child($toId).exists() && newData.child('at').val() <= now",
