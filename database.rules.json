{
  "rules": {
    ".read": false,
    ".write": false,
    "classes": {
      ".read": "auth != null && auth.token.superAdmin === true",
      ".write": "auth != null && auth.token.superAdmin === true",
      "$classCode": {
        ".read": "$classCode.matches(/^[A-Z0-9_-]+$/) && $classCode.length >= 3 && $classCode.length <= 16",
        ".validate": "$classCode.matches(/^[A-Z0-9_-]+$/) && $classCode.length >= 3 && $classCode.length <= 16",
        "meta": {
          ".write": "$classCode.matches(/^[A-Z0-9_-]+$/) && $classCode.length >= 3 && $classCode.length <= 16 && newData.exists() && (!data.exists() || (newData.child('teacherKeyHash').val() === data.child('teacherKeyHash').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
          "classCode": { ".validate": "newData.val() === $classCode" },
          "className": { ".validate": "newData.isString() && newData.val().length <= 40" }
        },
        "students": {
          "$studentId": { ".write": "newData.parent().parent().child('meta').exists()" }
        },
        "profiles": {
          "$studentId": { ".write": "newData.parent().parent().child('meta').exists()" }
        },
        "auctions": { ".write": "newData.parent().child('meta').exists()" },
        "tradeOffers": { ".write": "newData.parent().child('meta').exists()" },
        "pvp_squads": {
          "$studentId": { ".write": "newData.parent().parent().child('meta').exists()" }
        },
        "pvp_rooms": {
          "$roomId": { ".write": "newData.parent().parent().child('meta').exists()" }
        },
        "raid_rooms": {
          "$roomId": { ".write": "newData.parent().parent().child('meta').exists()" }
        },
        "minigame_rooms": {
          "$roomId": { ".write": "newData.parent().parent().child('meta').exists()" }
        },
        "minigames": {
          "$roomId": { ".write": "newData.parent().parent().child('meta').exists()" }
        },
        "live_battle_events": {
          "$eventId": { ".write": "newData.parent().parent().child('meta').exists()" }
        },
        "$other": { ".validate": false }
      }
    },
    "teacherKeys": {
      "$keyHash": {
        ".read": true,
        "classes": {
          "$classCode": {
            ".write": "$keyHash.matches(/^kh_[0-9a-f]+$/) && newData.exists() && newData.child('classCode').val() === $classCode && newData.parent().parent().parent().parent().child('classes').child($classCode).child('meta').child('teacherKeyHash').val() === $keyHash"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
